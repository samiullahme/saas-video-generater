# RecapMaker configuration. Copy to .env and fill in. Never commit real keys.
# In TEST MODE on this sandbox, leave the API keys empty and keep
# RECAPMAKER_TEST_AGENT=1: the vision/script stages wait for agent input
# and TTS uses the local /opt/hatch/bin/tts CLI.

# Server
RECAPMAKER_PORT=3150
RECAPMAKER_DATA_DIR=data
RECAPMAKER_TEST_AGENT=1

# Transcription (production: OpenAI-compatible Whisper API)
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
# Local faster-whisper model used when no TRANSCRIBE_API_KEY is set: tiny|base|small
WHISPER_MODEL=tiny

# Vision LLM (stage C: describe shots) — OpenAI-compatible chat API
VISION_LLM_API_KEY=
VISION_LLM_API_URL=https://api.openai.com/v1
VISION_LLM_MODEL=gpt-4o-mini

# Script LLM (stages D/E/F: outline, narration, verification)
SCRIPT_LLM_API_KEY=
SCRIPT_LLM_API_URL=https://api.openai.com/v1
SCRIPT_LLM_MODEL=gpt-4o-mini

# Shared fallback: if set, used for any LLM provider whose own key is empty
OPENAI_API_KEY=

# TTS (production: OpenAI-compatible TTS API; test mode uses local tts CLI)
TTS_API_KEY=
TTS_API_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=

# Cost estimates shown on the debug page (USD)
PRICE_INPUT_PER_1K_TOKENS=0.00015
PRICE_OUTPUT_PER_1K_TOKENS=0.0006
PRICE_TTS_PER_1K_CHARS=0.015
